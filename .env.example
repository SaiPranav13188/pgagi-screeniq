# ─── LLM ──────────────────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
# Leave empty to run in fully-offline mode (extractive questions + semantic grading).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Tried in order; unavailable / rate-limited models fall through to the next.
GEMINI_MODELS=gemini-3.8-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
LLM_TEMPERATURE=0.6

# ─── Storage ──────────────────────────────────────────────────────────────────
# Any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@localhost:5432/pgagi
# DATABASE_URL=sqlite:///./data/app.db
# BOOKS_DIR=../data/books
# Use a Qdrant server instead of the embedded on-disk store:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ─── RAG ──────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_TARGET_WORDS=230
CHUNK_MAX_WORDS=320
CHUNK_OVERLAP_SENTENCES=2
RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_K=4
MMR_LAMBDA=0.72
MIN_DENSE_SCORE=0.52

# ─── Interview policy ─────────────────────────────────────────────────────────
DEFAULT_QUESTION_COUNT=6
MAX_FOLLOW_UPS=2
FOLLOW_UP_THRESHOLD=4.5
ESCALATE_THRESHOLD=8.0

# ─── API ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
